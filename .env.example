# Neon pooled connection string for the participant pool database.
# Project: byc-participant-pool, region ap-southeast-1 (Singapore).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Password for the Lab Manager dashboard at /admin.
ADMIN_PASSWORD=choose-a-long-random-password

# Signing key for participant sign-in tokens. Rotating it signs everybody out.
SESSION_SECRET=64-hex-characters-from-openssl-rand-hex-32
